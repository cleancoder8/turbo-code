    "marked": "^4.3.0",
    "marked-terminal": "^7.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "ink-testing-library": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
